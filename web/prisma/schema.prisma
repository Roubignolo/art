// Modèle de données — registre de provenance + scoring + ventes.
// Aligné sur docs/backend-vercel.md §1, élargi pour porter les sorties
// des sous-agents Sourcing et Scoring sans perte d'information.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Work {
  id             Int      @id // objectID du musée (Met pour l'instant)
  title          String
  artist         String?
  artistBio      String?  // ex. "French, 1759-1840"
  artistDeath    Int?
  objectDate     String?  // libellé brut Met (peut contenir des dates approximatives)
  department     String?
  classification String?
  medium         String?
  dimensions     String?
  creditLine     String?
  source         String   @default("The Metropolitan Museum of Art (Open Access, CC0)")
  objectUrl      String?
  imageUrl       String?
  localFile      String?  // chemin dans le stockage objet (R2/S3) quand activé
  resolutionPx   Int      @default(0)
  width          Int?
  height         Int?

  // Gates de conformité (sourcing → revue humaine sur ue=null)
  gateUsSource   Boolean  @default(false)
  gateUe         Boolean? // null = à valider par un humain
  gateNoTm       Boolean  @default(true)
  resolutionOk   Boolean?

  // Preuve de domaine public (cf. agents/sources/base.py build_dp_evidence)
  artistBirth     Int?     // année de naissance auteur
  objectBeginYear Int?     // année de début de création
  accessionNumber String?  // n° d'inventaire institutionnel
  rightsStatement String?  // énoncé de droits (CC0, PD Mark, NoC, isPublicDomain…)
  wikidataUrl     String?  // référence Wikidata de l'œuvre
  dpEvidence      String?  // preuve consolidée, lisible (UE/US + institution + Wikidata)

  // Scoring (4 axes /10) — alimenté par l'heuristique ou Claude
  momentum       Int      @default(5)
  attribution    Int      @default(5)
  translatab     Int      @default(5)
  competition    Int      @default(5)
  scoreFinal     Float?
  hook           String? // accroche provenance (storytelling fiche produit, FR rapide)
  angle          String? // suggestion de différenciation si saturé

  // Marketing multilingue généré par Claude. Structure attendue :
  // { "fr": { title, listingTitle, description, hook, tags[] }, "en": {...}, ... }
  marketing      Json?

  // Mockups générés (3 templates Dynamic Mockups + 3 lifestyle IA Flux Pro Kontext).
  // Structure attendue : { product: { templates: [url, ...], lifestyle: [url, ...] } }
  mockups        Json?

  // Ligne produit pour routing POD : "standard" → Gelato, "signature" → Prodigi (cf.
  // docs/benchmark-pod-fournisseurs.md §5). Null = pas encore décidé.
  line           String?  // "standard" | "signature" | null

  // Listing Etsy associé (rempli après publish via /api/etsy/publish).
  etsyListingId  String?

  // Pipeline : source → gate → score → restore → publish
  status         String   @default("gate")
  collection     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales          Sale[]
  orders         Order[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  workId    Int
  product   String   // poster | framed | canvas | torchon | coussin | mug
  amount    Float
  soldAt    DateTime @default(now())

  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
}

// Commande full lifecycle : vente Etsy → production Gelato/Prodigi → tracking
// → livraison. Alimentée par les webhooks Etsy (création) et Gelato/Prodigi
// (status updates).
model Order {
  id                Int      @id @default(autoincrement())
  workId            Int
  marketplace       String   @default("etsy")   // etsy | ebay | shopify
  marketplaceOrderId String                       // ex: Etsy receipt_id
  provider          String                       // gelato | prodigi
  providerOrderId   String?                      // ex: Gelato order id
  product           String                       // ex: framed_poster_a2_oak
  quantity          Int      @default(1)
  amount            Float                        // total payé client (devise marketplace)
  currency          String   @default("EUR")
  status            String   @default("paid")    // paid | dispatched | in_production | shipped | delivered | canceled | error
  trackingCode      String?
  trackingUrl       String?
  customerName      String?
  customerCountry   String?
  errorMessage      String?  // si status=error, raison
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  work              Work     @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@unique([marketplace, marketplaceOrderId, product])
  @@index([workId])
  @@index([provider, status])
  @@index([createdAt])
}

// Validation HUMAINE du gate DP/marque des œuvres de la galerie (collection.json).
// Règle dure : aucune publication sans cette décision humaine. Clé = objectID musée
// (= champ `id` de collection.json). Distinct de Work.gateUe (œuvres déjà en base).
model CurationDecision {
  workId    Int      @id // objectID musée, = id dans collection.json
  status    String?      // gate DP humain : "valide" | "rejete" | null (à valider)
  active    Boolean  @default(false) // dans le catalogue commercial (en vente)
  note      String?      // raison de rejet / commentaire facultatif
  decidedAt DateTime @default(now())
}
