# Postgres (Neon recommandé — https://neon.tech, free tier 0.5 GB).
# Format : postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Mot de passe du cockpit (HTTP Basic Auth). Utilisateur par défaut : "art".
# Génère une chaîne longue : openssl rand -base64 24
COCKPIT_PASSWORD="change-me-please"
# Optionnel : surcharger le nom d'utilisateur Basic Auth (défaut: art)
# COCKPIT_USER="art"

# Anthropic — uniquement si tu veux le scoring momentum/concurrence par Claude.
# Sans cette clé, l'API /api/scoring renvoie 503 et le cockpit tombe en mode heuristique.
ANTHROPIC_API_KEY=""

# ─────────────────────────── Etsy (P3.3) ───────────────────────────
# Clé d'application Etsy (keystring) — https://www.etsy.com/developers/your-apps
ETSY_API_KEY=""
# OAuth2 PKCE : généré via /api/etsy/oauth?action=authorize puis échange du code.
ETSY_REDIRECT_URI="https://art-cockpit.vercel.app/api/etsy/oauth"
ETSY_OAUTH_TOKEN=""      # access_token (préfixé par l'user id, ex: 12345.xxxx)
ETSY_REFRESH_TOKEN=""    # refresh_token
ETSY_SHOP_ID=""          # id numérique de la boutique
ETSY_TAXONOMY_ID="68887" # catégorie Prints (défaut)
# Secret HMAC pour valider les webhooks Etsy (/api/etsy/webhook)
ETSY_WEBHOOK_SECRET=""

# ─────────────────────────── POD ───────────────────────────
GELATO_API_KEY=""
GELATO_WEBHOOK_SECRET=""   # secret URL signée (/api/gelato/webhook)
PRODIGI_API_KEY=""

# ─────────────────────────── Rendus / restauration ───────────────────────────
# Restauration cloud (Real-ESRGAN). Sans clé → moteur LOCAL Pillow (gratuit).
REPLICATE_API_TOKEN=""
# Mockups templates (étage 1). Sans clé → moteur LOCAL.
DYNAMIC_MOCKUPS_API_KEY=""
DYNAMIC_MOCKUPS_TEMPLATE_IDS=""   # uuids csv des templates pré-configurés
# Hero shots lifestyle IA (étage 2, Flux Pro Kontext). Sans clé → scènes LOCALES.
FAL_KEY=""
